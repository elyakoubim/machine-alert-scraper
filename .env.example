# ==============================================================================
# Machine Alert — Variables d'environnement
# ==============================================================================
# Copier ce fichier en .env et remplir les valeurs pour un run local.
# Sur Railway, configurer ces variables dans Variables (pas dans le repo).
# JAMAIS committer le .env réel dans Git.

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_TOKEN=pat_XXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appQrNOm3Q7D9uEed
AIRTABLE_ANNONCES_TABLE=tbljV9HICBsPyqjQk
AIRTABLE_PROFILS_TABLE=tblXhuS0M1TtRuSel
AIRTABLE_SOURCES_TABLE=tblPaOrQekEMdaW5x

# ── Anthropic (Claude Haiku pour catégorisation + fallback extraction) ────────
# Créer une clé sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── ScraperAPI (fallback anti-bot pour sites Cloudflare/captcha) ──────────────
# Clé disponible sur https://dashboard.scraperapi.com
# Plan Free : 5000 crédits/mois suffisent pour démarrer
SCRAPERAPI_KEY=XXXXXXXXXXXXXXXX

# ── Scraping général ──────────────────────────────────────────────────────────
# Délai mini entre 2 requêtes sur un même domaine (en secondes)
RATE_LIMIT_SECONDS=2.0
# User-Agent HTTP par défaut
USER_AGENT=Mozilla/5.0 (compatible; FaillinkBot/1.0; +https://faillink.be/bot)